# Port du serveur
PORT=3000

# URL publique du site une fois déployé (sans slash final)
PUBLIC_BASE_URL=https://votre-domaine.exemple.com

# --- Instagram / Meta Graph API ---
# Jeton que TU inventes (une phrase aléatoire), à recopier dans la config du webhook Meta
META_VERIFY_TOKEN=change_moi_avec_une_phrase_secrete

# Jeton d'accès Page généré depuis l'App Meta Developer (Graph API Explorer ou flux OAuth)
META_PAGE_ACCESS_TOKEN=

# App Secret de ton App Meta Developer (onglet Paramètres de base), sert à
# vérifier que les webhooks reçus viennent bien de Meta
META_APP_SECRET=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Numéro WhatsApp de Gabriel qui reçoit les notifications, format international sans + ni espaces
GABRIEL_WHATSAPP_NUMBER=33600000000

# Lien wa.me affiché sur la page de confirmation (même numéro, avec le +)
GABRIEL_WHATSAPP_LINK=https://wa.me/33600000000

# --- Tableau de bord ---
DASHBOARD_USER=gabriel
DASHBOARD_PASSWORD=change_moi
